<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <include domain="sharedpref" />
        <include domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="/" />
    </device-transfer>
</data-extraction-rules>
